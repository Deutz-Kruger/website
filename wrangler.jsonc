{
  "main": "dist/_worker.js/index.js",
  "name": "deutz-krueger-portfolio",
  "preview_urls": true,
  "compatibility_date": "2025-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": [
      "/",
      "/en/impressum",
      "/en/impressum/",
      "/en/privacy",
      "/en/privacy/"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
