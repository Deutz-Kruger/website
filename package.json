{
  "name": "deutz-krueger-portfolio",
  "private": "true",
  "type": "module",
  "version": "0.0.1",
  "author": "Marvin Deutz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deutz-Kruger/website"
  },
  "homepage": "https://deutzkrueger.de",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm perf:budget && pnpm verify:build",
    "preview": "astro build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy-cf": "astro build && wrangler deploy",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "astro check",
    "check": "eslint . --ext .js,.ts,.astro && prettier --check . && astro check",
    "perf:budget": "node ./scripts/performance-budget.mjs",
    "verify:build": "node ./scripts/verify-build.mjs",
    "prepare": "husky",
    "sync-media": "tsx ./media-sync/cli.ts sync",
    "sync-media:prune": "tsx ./media-sync/cli.ts prune",
    "sync-media:audit": "tsx ./media-sync/cli.ts audit",
    "sync-media:cleanup-legacy": "tsx ./media-sync/cli.ts cleanup-legacy",
    "test": "pnpm test:unit && pnpm test:media",
    "test:unit": "tsx --test ./test/*.test.ts",
    "test:media": "tsx --test ./media-sync/**/*.test.ts",
    "reset:cache": "rm -rf .astro .cache .wrangler dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@nanostores/persistent": "^1.2.0",
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.11",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.16.15",
    "clsx": "^2.1.1",
    "glob": "^11.1.0",
    "gsap": "^3.13.0",
    "hls.js": "^1.6.15",
    "lenis": "^1.3.15",
    "marked": "^17.0.1",
    "nanostores": "^1.1.0",
    "swup": "^4.8.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@eslint/js": "^9.39.1",
    "@types/ffprobe": "^1.1.8",
    "@types/ffprobe-static": "^2.0.3",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^0.8.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.34.5",
    "sonda": "^0.9.0",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "wrangler": "^4.50.0",
    "zod": "^4.1.13"
  }
}
