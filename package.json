{
  "name": "deutz-krueger-portfolio",
  "private": "true",
  "type": "module",
  "version": "0.0.1",
  "author": "Marvin Deutz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deutz-Kruger/website"
  },
  "homepage": "https://deutzkrueger.de",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm perf:budget && pnpm verify:build",
    "preview": "astro build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy-cf": "astro build && wrangler deploy",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "astro check",
    "check": "eslint . --ext .js,.ts,.astro && prettier --check . && astro check",
    "perf:budget": "node ./scripts/performance-budget.mjs",
    "verify:build": "node ./scripts/verify-build.mjs",
    "prepare": "husky",
    "sync-media": "tsx ./media-sync/cli.ts sync",
    "sync-media:prune": "tsx ./media-sync/cli.ts prune",
    "sync-media:audit": "tsx ./media-sync/cli.ts audit",
    "sync-media:cleanup-legacy": "tsx ./media-sync/cli.ts cleanup-legacy",
    "test": "pnpm test:unit && pnpm test:media",
    "test:unit": "tsx --test ./test/*.test.ts",
    "test:media": "tsx --test ./media-sync/**/*.test.ts",
    "reset:cache": "rm -rf .astro .cache .wrangler dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@nanostores/persistent": "^1.3.5",
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.12",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "clsx": "^2.1.1",
    "glob": "^14.0.6",
    "gsap": "^3.15.1",
    "hls.js": "^1.7.4",
    "lenis": "^1.3.27",
    "marked": "^18.2.0",
    "nanostores": "^1.5.5",
    "swup": "^4.10.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/ffprobe": "^1.1.8",
    "@types/ffprobe-static": "^2.0.3",
    "astro-robots-txt": "^1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "sonda": "^0.14.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0",
    "zod": "^4.6.7"
  }
}
