---
import LangSelectDe from "@content/media/lang_select_de.svg";
import LangSelectEn from "@content/media/lang_select_en.svg";
---

<div
  class="hide-me pointer-events-auto relative flex h-full w-fit select-none justify-between gap-2 md:self-center"
>
  <div
    aria-label="Switch to English"
    role="navigation"
    lang="en"
    data-listener-attached="false"
    class="hover:scale-102 aspect-103/59 hidden h-1/2 transition-transform duration-150 ease-in-out hover:-rotate-3 hover:cursor-pointer md:h-full"
    id="en"
  >
    <LangSelectEn class="h-full w-full" />
  </div>

  <div
    aria-label="Switch to German"
    role="navigation"
    lang="de"
    data-listener-attached="false"
    class="aspect-104/59 hover:scale-102 hidden h-1/2 transition-transform duration-150 ease-in-out hover:rotate-3 hover:cursor-pointer md:h-full"
    id="de"
  >
    <LangSelectDe class="h-full w-full" />
  </div>
</div>
