---
import { cn } from "@/utils/cn";

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<div class={cn(className, "max-h-[62vh] -mx-4")}>
  <div class="glide h-full">
    <div class="glide__track -mx-8" data-glide-el="track">
      <ul class="glide__slides h-full">
        <slot />
      </ul>
    </div>
  </div>
</div>

<script src="@/scripts/carousel.ts"></script>
