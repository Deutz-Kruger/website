---
import { cn } from "@/utils/cn";

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<div class={cn(className, "swiper min-h-56 w-full")} id="carousel">
  <div class="swiper-wrapper h-full p-4">
    <slot />
  </div>
</div>

<slot id="non-carousel" />

<script>
  import "swiper/css";
  import "swiper/css/autoplay";
  import "swiper/css/a11y";

  import { useUserAgent } from "astro-useragent";

  const { isMobile } = useUserAgent(navigator.userAgent);

  const carousel = document.getElementById("carousel");
  const nonCarousel = document.getElementById("non-carousel");
  const swiperSlides = document.getElementsByClassName("swiper-slide");

  if (isMobile) {
    nonCarousel?.remove();
  } else {
    carousel?.remove();
    for (const slide of swiperSlides) {
      slide.classList.remove("swiper-slide");
    }
  }

  import Swiper from "swiper";
  import { A11y, Autoplay } from "swiper/modules";

  const swiper = new Swiper(".swiper", {
    modules: [Autoplay, A11y],
    direction: "horizontal",
    loop: true,

    speed: 700,
    spaceBetween: 100,

    autoHeight: true,
    observer: true,
    observeParents: true,

    autoplay: {
      delay: 5000,
      pauseOnMouseEnter: true,
    },
  });

  swiper.init();
</script>
