---
import { cn } from "@/utils/cn";

interface Props {
  className?: string;
}

const { className } = Astro.props;

const uniqueId = `swiper-${crypto.randomUUID()}`;
---

<div id={uniqueId} class={cn(className, "swiper min-h-56 w-full")}>
  <div class="swiper-wrapper h-full">
    <slot />
  </div>
</div>

<script define:vars={{ uniqueId }} is:inline>
  /*global uniqueId */
  const swiperElement = document.getElementById(uniqueId);

  if (!window.swiperLoader) {
    const loadJs = new Promise((resolve, reject) => {
      const script = document.createElement("script");

      script.onload = () => {
        resolve();
      };
      script.onerror = reject;
      script.src =
        "https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js";
      document.head.appendChild(script);
    });

    const loadCss = new Promise((resolve, reject) => {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.onload = () => {
        resolve();
      };
      link.onerror = reject;

      link.href =
        "https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css";
      document.head.appendChild(link);
    });

    window.swiperLoader = Promise.all([loadJs, loadCss]);
  }

  window.swiperLoader
    .then(() => {
      // eslint-disable-next-line @typescript-eslint/no-unused-vars
      const swiper = new window.Swiper(swiperElement, {
        direction: "horizontal",
        // loop: true,

        speed: 700,
        spaceBetween: 200,

        slidesPerView: "auto",
        centeredSlides: true,
        autoHeight: true,
        observer: true,
        observeParents: true,

        autoplay: {
          delay: 5000,
          pauseOnMouseEnter: true,
        },
      });
    })
    .catch((err) => {
      console.error("Failed to load Swiper", err);
    });
</script>
