---
import type { z } from "astro:content";

import type { videoBlock } from "@/content/schemas/blockSchemas";
import { cn } from "@/utils/cn";
import { generateGridPosition } from "@/utils/layoutCalc";

import HlsVideo from "../util/HlsVideo.astro";
import Background from "./utils/Background.astro";

type CaseVideoBlock = z.infer<typeof videoBlock>;

interface Props {
  block: CaseVideoBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "" } = Astro.props;
const { video, base } = block;
const { background, layout } = base;
const positioning = generateGridPosition(layout);
---

<section
  class={cn(className)}
  data-desktop-start={positioning.desktopStart}
  data-desktop-span={positioning.desktopSpan}
  data-aspect-width={positioning.aspect.width}
  data-aspect-height={positioning.aspect.height}
  style={`--desktop-start: ${positioning.desktopStart}; --desktop-span: ${positioning.desktopSpan}; --aspect-width: ${positioning.aspect.width}; --aspect-height: ${positioning.aspect.height}`}
>
  <Background
    className={cn("h-full w-full", className)}
    background={background}
  >
    <HlsVideo
      src={video}
      loading={loading}
      className={cn({})}
      hasBackground={background.background !== "none"}
    />
  </Background>
</section>
