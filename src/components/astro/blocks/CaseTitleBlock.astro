---
import type { z } from "astro:content";

import type { titleBlock } from "@/content/schemas/blockSchemas";
import { cn } from "@/utils/cn";

type CaseTitleBlock = z.infer<typeof titleBlock>;

interface Props {
  block: CaseTitleBlock;
  className?: string;
  index: number;
}

const { block, className = "", index } = Astro.props;
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const marginRight = index % 2 === 0;
---

<section class={cn("aspect-block", className)}>
  <h1 class="text-large md:text-largest mb-2 leading-[1]">{block.title}</h1>
  <p class="md:text-big text-base leading-[1.125]">{block.subHeading}</p>
</section>
