---
import type { z } from "astro:content";

import type { caseTitleBlock } from "@/content/config";
import { cn } from "@/utils/cn";

type CaseTitleBlock = z.infer<typeof caseTitleBlock>;

interface Props {
  block: CaseTitleBlock;
  className?: string;
  index: number;
}

const { block, className = "", index } = Astro.props;
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const marginRight = index % 2 === 0;
---

<section class={cn("w-full", className)}>
  <h1 class="text-large md:text-largest">{block.title}</h1>
  <p class="md:text-big leading text-base">{block.subHeading}</p>
</section>
