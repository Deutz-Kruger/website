---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { caseImageTextFullBlock } from "@/content/config";
import { cn } from "@/utils/cn";

type CaseImageTextFullBlock = z.infer<typeof caseImageTextFullBlock>;

interface Props {
  block: CaseImageTextFullBlock;
  loading: string;
  className?: string;
  index: number;
}
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const { block, loading, className = "", index } = Astro.props;
const { image, text, textRight } = block;
---

<div class={cn("w-screen flex", className)}>
  <p>{text}</p>
  <ImageWrapper
    className={cn(textRight ? "order-first" : "order-last")}
    src={image.image}
    altText={image.alt}
    loading={loading}
  />
</div>
