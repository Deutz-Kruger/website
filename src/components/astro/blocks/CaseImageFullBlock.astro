---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { caseImageFullBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import Carousel from "../Carousel.astro";
import caseBlockStyles from "./CaseBlock.module.css";

type CaseImageFullBlock = z.infer<typeof caseImageFullBlock>;

interface Props {
  block: CaseImageFullBlock;
  loading: string;
  className?: string;
  index: number;
}
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const { block, loading, className = "", index } = Astro.props;
const { images, animatedBg, bgCols } = block;
---

<div class={cn("case-block-full md:h-96", className)}>
  {
    animatedBg ? (
      <BackgroundGradient
        client:visible
        className={cn()}
        contentType="images"
        images={images}
        gradientCols={bgCols}
      >
        <div class={caseBlockStyles.mobileView}>
          <Carousel>
            {images.map((image) => (
              <div class="swiper-slide py-4">
                <ImageWrapper
                  src={image.image}
                  altText={image.alt}
                  loading={loading}
                  className="w-2/3 mx-auto md:w-fit md:h-96"
                />
              </div>
            ))}
          </Carousel>
        </div>

        <div class={caseBlockStyles.desktopView}>
          {images.map((image) => (
            <div class="py-4">
              <ImageWrapper
                src={image.image}
                altText={image.alt}
                loading={loading}
                className="w-2/3 mx-auto md:w-fit md:h-96"
              />
            </div>
          ))}
        </div>
      </BackgroundGradient>
    ) : (
      images.map((image) => (
        <ImageWrapper
          src={image.image}
          altText={image.alt}
          loading={loading}
          className="w-2/3 mx-auto md:w-fit md:h-96"
        />
      ))
    )
  }
</div>
