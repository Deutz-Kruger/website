---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { caseImageFullBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import Carousel from "../Carousel.astro";
import caseBlockStyles from "./CaseBlock.module.css";
import Background from "./utils/Background.astro";

type CaseImageFullBlock = z.infer<typeof caseImageFullBlock>;

interface Props {
  block: CaseImageFullBlock;
  loading: string;
  className?: string;
  index: number;
}
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const { block, loading, className = "", index } = Astro.props;
const { images, background } = block;
---

<div class="case-block-full">
  <Background
    background={background}
    numberOfItems={images.length}
    className="h-fit"
  >
    <div class={cn(caseBlockStyles.mobileView)}>
      <Carousel>
        {
          images.map((image) => (
            <div class="swiper-slide !w-2/3 p-4">
              <ImageWrapper
                src={image.image}
                altText={image.alt}
                loading={loading}
                className="w-screen md:w-fit h-60 md:h-96 rounded-media"
              />
            </div>
          ))
        }
      </Carousel>
    </div>

    <div class={cn(caseBlockStyles.desktopView)}>
      {
        images.map((image) => (
          <div class="py-4">
            <ImageWrapper
              src={image.image}
              altText={image.alt}
              loading={loading}
              className="mx-auto md:w-fit md:h-fit max-h-96  object-contain rounded-media"
            />
          </div>
        ))
      }
    </div>
  </Background>
</div>
