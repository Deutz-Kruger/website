---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { caseImageFullBlock } from "@/content/config";
import { cn } from "@/utils/cn";

type CaseImageFullBlock = z.infer<typeof caseImageFullBlock>;

interface Props {
  block: CaseImageFullBlock;
  loading: string;
  className?: string;
  index: number;
}
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const { block, loading, className = "", index } = Astro.props;
const { images, animatedBg, bgCols } = block;
---

<div class={cn("case-block-full md:h-96", className)}>
  {
    animatedBg ? (
      <BackgroundGradient
        client:visible
        className={cn("p-4")}
        contentType="images"
        images={images}
        gradientCols={bgCols}
      >
        {images.map((image) => (
          <ImageWrapper
            src={image.image}
            altText={image.alt}
            loading={loading}
            className="md:h-96"
          />
        ))}
      </BackgroundGradient>
    ) : (
      images.map((image) => (
        <ImageWrapper src={image.image} altText={image.alt} loading={loading} />
      ))
    )
  }
</div>
