---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { imageBlock } from "@/content/schemas/blockSchemas";
import { cn } from "@/utils/cn";
import { generateGridPosition } from "@/utils/layoutCalc";

import Background from "./utils/Background.astro";

type ImageBlock = z.infer<typeof imageBlock>;

interface Props {
  block: ImageBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className } = Astro.props;
const { base, images } = block;
const { layout, background } = base;
const positioning = generateGridPosition(layout);
const hasMultipleImages = images.length > 1;
let dynamicSizes = "100vw";

if (positioning.desktopSpan === 1) {
  dynamicSizes = "(min-width: 1024px) 25vw, 100vw";
} else if (positioning.desktopSpan === 2) {
  dynamicSizes = "(min-width: 1024px) 50vw, 100vw";
} else if (positioning.desktopSpan === 3) {
  dynamicSizes = "(min-width: 1024px) 75vw, 100vw";
} else if (positioning.desktopSpan === 4) {
  dynamicSizes = "(min-width: 1024px) 100vw, 100vw";
}
---

<section
  class={cn("h-full w-full ", className)}
  data-desktop-start={positioning.desktopStart}
  data-desktop-span={positioning.desktopSpan}
  data-aspect-width={positioning.aspect.width}
  data-aspect-height={positioning.aspect.height}
  style={`--desktop-start: ${positioning.desktopStart}; --desktop-span: ${positioning.desktopSpan}; --aspect-width: ${positioning.aspect.width}; --aspect-height: ${positioning.aspect.height}`}
>
  <Background
    background={background}
    margin={positioning.margin}
    className={cn("h-full w-full lg:h-full lg:max-h-full lg:w-fit", {
      "flex justify-around gap-1": hasMultipleImages,
      "py-6 lg:px-12": positioning.desktopSpan < 2,
    })}
  >
    <ImageWrapper
      loading={loading}
      src={images[0].src}
      imgClassName={cn({ "max-h-[33vh]": positioning.desktopSpan < 2 })}
      altText={images[0].alt}
      sizes={dynamicSizes}
    />
  </Background>
</section>
