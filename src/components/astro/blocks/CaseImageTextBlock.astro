---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { caseImageTextBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import Background from "./utils/Background.astro";

type CaseImageTextBlock = z.infer<typeof caseImageTextBlock>;

interface Props {
  block: CaseImageTextBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "" } = Astro.props;
const { image, text, textRight, background } = block;
---

<!-- TODO: Fix height of image, especially without text -->
<div class={cn("grid grid-cols-2 gap-8 aspect-block", className)}>
  <p
    class={cn("md:text-medium  text-base leading-[1.125]", {
      "order-last": textRight,
    })}
  >
    {text}
  </p>

  <Background
    background={background}
    className={cn("padding-background-half grid h-full w-full items-center")}
  >
    <ImageWrapper
      src={image.image}
      altText={image.alt}
      loading={loading}
      className="ml-auto h-full w-fit"
      objectFit="cover"
    />
  </Background>
</div>
