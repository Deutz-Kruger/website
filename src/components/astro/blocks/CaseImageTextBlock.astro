---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { caseImageTextBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import Background from "./utils/Background.astro";

type CaseImageTextBlock = z.infer<typeof caseImageTextBlock>;

interface Props {
  block: CaseImageTextBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "", index } = Astro.props;
const { image, text, textRight, background } = block;

const side = textRight ? "order-first" : "order-last";

const marginRight = index % 2 === 0;
---

<div
  class={cn(
    "flex justify-between mb-4 md:mb-6 case-block",
    marginRight ? "md:mr-auto" : "",
    className,
  )}
>
  <p class="md:text-medium leading-[1.125]! w-1/2 pr-6 text-base">{text}</p>
  <Background
    background={background}
    numberOfItems={1}
    className={cn("block-background-half grid w-[25vw] items-center", side)}
  >
    <ImageWrapper src={image.image} altText={image.alt} loading={loading} />
  </Background>
</div>
