---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { caseImageTextBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import Background from "./utils/Background.astro";

type CaseImageTextBlock = z.infer<typeof caseImageTextBlock>;

interface Props {
  block: CaseImageTextBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "" } = Astro.props;
const { image, text, textRight, background } = block;

const textPosition = textRight ? "flex-row-reverse" : "";
---

<div class={cn("flex justify-between gap-8", textPosition, className)}>
  <p class="md:text-medium w-1/2 text-base leading-[1.125]">{text}</p>
  <Background
    background={background}
    className={cn("block-background-half grid w-1/2 items-center")}
  >
    <ImageWrapper
      src={image.image}
      altText={image.alt}
      loading={loading}
      className="h-full w-full"
    />
  </Background>
</div>
