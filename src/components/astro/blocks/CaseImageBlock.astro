---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import type { z } from "astro:content";

import type { caseImageBlock } from "@/content/config";
import { cn } from "@/utils/cn";

type CaseImageBlock = z.infer<typeof caseImageBlock>;

interface Props {
  block: CaseImageBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "", index } = Astro.props;
const { image } = block;
const marginRight = index % 2 === 0;
---

<div class={cn(className, marginRight ? "md:mr-auto" : "")}>
  <ImageWrapper src={image.image} altText={image.alt} loading={loading} />
</div>
