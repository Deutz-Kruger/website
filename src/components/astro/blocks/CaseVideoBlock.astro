---
import type { z } from "astro:content";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { caseVideoBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import VideoWrapper from "../util/VideoWrapper.astro";

type CaseVideoBlock = z.infer<typeof caseVideoBlock>;

interface Props {
  block: CaseVideoBlock;
  loading: string;
  className?: string;
}

const { block, loading, className = "" } = Astro.props;
const { video, animatedBg, bgCols } = block;
---

<div class={cn(className, "w-full md:w-1/2 mb-4 md:mb-6 h-52 md:h-96")}>
  {
    animatedBg ? (
      <BackgroundGradient
        className="py-2 px-4 md:py-4 md:px-8"
        client:visible
        contentType="video"
        video={video}
        gradientCols={bgCols}
      >
        <VideoWrapper src={video} loading={loading} />
      </BackgroundGradient>
    ) : (
      <VideoWrapper src={video} loading={loading} />
    )
  }
</div>
