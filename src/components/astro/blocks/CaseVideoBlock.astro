---
import type { z } from "astro:content";

import type { caseVideoBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import VideoWrapper from "../util/VideoWrapper.astro";
import Background from "./utils/Background.astro";

type CaseVideoBlock = z.infer<typeof caseVideoBlock>;

interface Props {
  block: CaseVideoBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "", index } = Astro.props;
const { video, background } = block;

const marginRight = index % 2 === 0;
---

<section class={cn(className, "case-block", marginRight ? "md:mr-auto" : "")}>
  <Background numberOfItems={1} background={background}>
    <VideoWrapper
      src={video}
      loading={loading}
      className={cn("rounded-media")}
    />
  </Background>
</section>
