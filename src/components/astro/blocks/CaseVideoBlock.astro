---
import type { z } from "astro:content";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { caseVideoBlock } from "@/content/config";
import { cn } from "@/utils/cn";

import VideoWrapper from "../util/VideoWrapper.astro";

type CaseVideoBlock = z.infer<typeof caseVideoBlock>;

interface Props {
  block: CaseVideoBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "", index } = Astro.props;
const { video, background } = block;

const marginRight = index % 2 === 0;
---

<div
  class={cn(
    className,
    "case-block mb-4 md:mb-6",
    marginRight ? "md:mr-auto" : "",
  )}
>
  {
    background.bgBools.animatedBg ? (
      <BackgroundGradient
        className="gradient-background"
        client:visible
        contentType="video"
        video={video}
        gradientCols={background.bgCols}
      >
        <VideoWrapper src={video} loading={loading} />
      </BackgroundGradient>
    ) : (
      <VideoWrapper src={video} loading={loading} />
    )
  }
</div>
