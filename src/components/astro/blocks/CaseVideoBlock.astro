---
import type { z } from "astro:content";

import type { videoBlock } from "@/content/schemas/blockSchemas";
import { cn } from "@/utils/cn";

import VideoWrapper from "../util/VideoWrapper.astro";
import Background from "./utils/Background.astro";

type CaseVideoBlock = z.infer<typeof videoBlock>;

interface Props {
  block: CaseVideoBlock;
  loading: string;
  className?: string;
  index: number;
}

const { block, loading, className = "" } = Astro.props;
const { video, base } = block;
---

<section class={cn(className, "aspect-block")}>
  <Background background={base.background}>
    <VideoWrapper
      src={video}
      loading={loading}
      className={cn("rounded-media h-full")}
    />
  </Background>
</section>
