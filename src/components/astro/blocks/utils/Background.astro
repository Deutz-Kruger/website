---
import type { z } from "astro:content";

// import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { backgroundField } from "@/content/schemas/fieldSchemas";
import { cn } from "@/utils/cn";

type Background = z.infer<typeof backgroundField>;

interface Props {
  background: Background;
  margin?: string;
  className?: string;
  width?: number;
}

const { background, className = "", margin, width } = Astro.props;
const staticCol = background?.background_colors
  ? background?.background_colors[0]
  : "#EBEBEB";
---

<>
  {
    background.background === "static" ? (
      <div
        style={`background: ${staticCol};`}
        class={cn(className, "padding-background h-full w-full", {
          "md:w-fit": width && width < 2,
          "w-full": !margin || margin === "NONE",
          "ml-auto": margin === "LEFT",
          "mr-auto": margin === "RIGHT",
        })}
      >
        <slot />
      </div>
    ) : (
      <div
        class={cn(className, "p-0! h-full w-full lg:w-fit", {
          "w-full": !margin || margin === "NONE",
          "ml-auto": margin === "LEFT",
          "mr-auto": margin === "RIGHT",
        })}
      >
        <slot />
      </div>
    )
  }
</>
