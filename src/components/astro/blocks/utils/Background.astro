---
import type { z } from "astro:content";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { backgroundField } from "@/content/schemas/fieldSchemas";
import { cn } from "@/utils/cn";

type Background = z.infer<typeof backgroundField>;

interface Props {
  background: Background;
  margin?: string;
  className?: string;
}

const { background, className = "", margin } = Astro.props;
const staticCol = background?.background_colors
  ? background?.background_colors[0]
  : "#EBEBEB";
---

<>
  {
    background.background === "gradient" ? (
      <BackgroundGradient
        className={cn(className, "padding-background w-full")}
        client:visible
        gradientCols={background.background_colors}
      >
        <slot />
      </BackgroundGradient>
    ) : background.background === "static" ? (
      <div
        style={`background: ${staticCol};`}
        class={cn(className, "padding-background h-full w-full md:w-fit", {
          "w-full": !margin || margin === "NONE",
          "ml-auto": margin === "LEFT",
          "mr-auto": margin === "RIGHT",
        })}
      >
        <slot />
      </div>
    ) : (
      <div
        class={cn(className, "p-0! h-full w-full md:w-fit", {
          "w-full": !margin || margin === "NONE",
          "ml-auto": margin === "LEFT",
          "mr-auto": margin === "RIGHT",
        })}
      >
        <slot />
      </div>
    )
  }
</>
