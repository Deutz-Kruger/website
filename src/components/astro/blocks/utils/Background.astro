---
import type { z } from "astro:content";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import type { backgroundField } from "@/content/schemas/fieldSchemas";
import { cn } from "@/utils/cn";

type Background = z.infer<typeof backgroundField>;

interface Props {
  background: Background;

  className?: string;
}

const { background, className = "" } = Astro.props;
const staticCol = background?.background_colors
  ? background?.background_colors[0]
  : "#EBEBEB";
---

<>
  {
    background.background === "gradient" ? (
      <BackgroundGradient
        className={cn(className, "padding-background")}
        client:visible
        gradientCols={background.background_colors}
      >
        <slot />
      </BackgroundGradient>
    ) : background.background === "static" ? (
      <div style={`background: ${staticCol}`} class={cn(className)}>
        <slot />
      </div>
    ) : (
      <div class={cn(className, "p-0! h-full")}>
        <slot />
      </div>
    )
  }
</>
