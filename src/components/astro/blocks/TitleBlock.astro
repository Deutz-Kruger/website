---
import type { z } from "astro:content";

import type { titleBlock } from "@/content/schemas/blockSchemas";
import { cn } from "@/utils/cn";
import { generateGridPosition } from "@/utils/layoutCalc";

type CaseTitleBlock = z.infer<typeof titleBlock>;

interface Props {
  block: CaseTitleBlock;
  className?: string;
  index: number;
}

const { block, className = "" } = Astro.props;
const { layout } = block.base;
const positioning = generateGridPosition(layout);
---

<section
  class={cn("block-title-typo mb-12 md:mb-0", className)}
  data-desktop-start={positioning.desktopStart}
  data-desktop-span={positioning.desktopSpan}
  data-aspect-width={positioning.aspect.width}
  data-aspect-height={positioning.aspect.height}
  style={`--desktop-start: ${positioning.desktopStart}; --desktop-span: ${positioning.desktopSpan}; --aspect-width: ${positioning.aspect.width}; --aspect-height: ${positioning.aspect.height}`}
>
  <h1 class="w-7/8 2xl:w-7/8 mb-3 md:mb-2">{block.title}</h1>
  <p class="xl:w-11/16">{block.subHeading}</p>
</section>
