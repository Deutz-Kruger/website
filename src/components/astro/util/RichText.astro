---
import { marked } from "marked";

import { cn } from "@/utils/cn";

interface Props {
  richText: string | undefined;
  className?: string;
}

const { richText, className } = Astro.props;

if (!richText) return;

const innerHtml = marked.parse(richText);
---

<div class={cn("rich-text", className)} set:html={innerHtml} />
