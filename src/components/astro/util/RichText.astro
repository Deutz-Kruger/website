---
import { cn } from "@/utils/cn";
import { renderSafeMarkdown } from "@/utils/contentSecurity";

interface Props {
  richText: string | undefined;
  className?: string;
}

const { richText, className } = Astro.props;

if (!richText) return;

const innerHtml = renderSafeMarkdown(richText);
---

<div class={cn("rich-text", className)} set:html={innerHtml} />
