---
import { getAspectPercantage } from "@/utils/aspectRatio";
import { cn } from "@/utils/cn";
import { getMedia } from "@/utils/media";

interface Props {
  src: string;
  loading: string;
  className?: string;
}

const { src, loading, className = "" } = Astro.props;

const mediaEntry = getMedia(src);
const videoId = mediaEntry.id;

const iframeId = `player-${videoId}`;

const iframeSrc = `https://customer-k0tb9kusbwt5rfcb.cloudflarestream.com/${videoId}iframe`;

const paddingTopPercent =
  mediaEntry.width && mediaEntry.height
    ? getAspectPercantage(mediaEntry.width, mediaEntry.height)
    : 56.25;
---

<div class={cn(className, "")}>
  <div
    class=""
    style=`position: relative; padding-top: ${paddingTopPercent.toFixed(2)}%`
  >
    <iframe
      id={iframeId}
      title={mediaEntry.id}
      src={iframeSrc}
      style="border: none; position: absolute; top: 0; height: 100%; width: 100%"
      allowfullscreen="true"
      loading={loading === "eager" ? "eager" : "lazy"}></iframe>
  </div>
</div>
<script is:inline src="https://embed.cloudflarestream.com/embed/sdk.latest.js"
></script>

<script define:vars={{ iframeId }} is:inline>
  /*global Stream, iframeId*/
  setTimeout(() => {
    console.log(`[Player] Initializing for iframe ID: ${iframeId}`);
    const iframe = document.getElementById(iframeId);
    console.log(`[Player] Iframe element for ${iframeId}:`, iframe);
    console.log(
      `[Player] Cloudflare Stream SDK for ${iframeId}:`,
      typeof Stream,
    );

    if (iframe && typeof Stream === "function") {
      try {
        const player = Stream(iframe);
        player.muted = true;
        player.autoplay = true;
        player.controls = false;
        player.loop = true;
        player.play().catch(() => {
          console.error(`[Player] Playback failed for ${iframeId}`);
          player.play();
        });
      } catch (e) {
        console.error(`[Player] Error creating player for ${iframeId}:`, e);
      }
    } else {
      console.error(
        `[Player] Failed to initialize for ${iframeId}. Iframe or Stream SDK was not ready.`,
      );
    }
  }, 0);
</script>
