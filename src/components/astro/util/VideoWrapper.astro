---
import { getAspectPercantage } from "@/utils/aspectRatio";
import { getMedia } from "@/utils/media";

interface Props {
  src: string;
  loading: string;
}

const { src, loading } = Astro.props;

const mediaEntry = getMedia(src);
const videoId = mediaEntry.id;

const iframeId = `player-${videoId}`;

const iframeSrc = `https://customer-k0tb9kusbwt5rfcb.cloudflarestream.com/${videoId}iframe`;

const paddingTopPercent =
  mediaEntry.width && mediaEntry.height
    ? getAspectPercantage(mediaEntry.width, mediaEntry.height)
    : 56.25;
---

<div style=`position: relative; padding-top: ${paddingTopPercent.toFixed(2)}%`>
  <iframe
    id={iframeId}
    title={mediaEntry.id}
    src={iframeSrc}
    style="border: none; position: absolute; top: 0; height: 100%; width: 100%"
    allowfullscreen="true"
    loading={loading === "eager" ? "eager" : "lazy"}></iframe>
</div>
<script is:inline src="https://embed.cloudflarestream.com/embed/sdk.latest.js"
></script>
<script define:vars={{ iframeId }}>
  /*global Stream, iframeId*/
  const iframe = document.getElementById(iframeId);

  const player = Stream(iframe);
  player.muted = true;
  player.autoplay = true;
  player.controls = false;
  player.play().catch(() => {
    console.log("Playback failed");
    player.muted = true;
    player.play();
  });
</script>
