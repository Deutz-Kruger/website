---
import { cn } from "@/utils/cn";
import { getMedia, getVideoPosterSources } from "@/utils/media";

interface Props {
  src: string;
  className?: string;
  priority?: boolean;
}

const { src, className = "", priority = false } = Astro.props;

const { id: videoId } = getMedia(src);
const poster = getVideoPosterSources(src);
const manifestUrl = `https://customer-k0tb9kusbwt5rfcb.cloudflarestream.com/${videoId}/manifest/video.m3u8`;
---

<div class={cn("block", className)} data-video-frame-wrapper>
  <div
    class="relative w-full"
    data-video-frame
    style={`aspect-ratio: ${poster.width} / ${poster.height};`}
  >
    <preview-video
      src={manifestUrl}
      class="absolute inset-0 z-0 block h-full w-full opacity-0"
      data-media-player
      aria-hidden="true"
      width={poster.width}
      height={poster.height}
    >
    </preview-video>
    <img
      src={poster.src}
      srcset={poster.srcset}
      sizes="(min-width: 1280px) 44vw, 100vw"
      alt=""
      aria-hidden="true"
      width={poster.width}
      height={poster.height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "auto" : "low"}
      decoding="async"
      draggable="false"
      data-media-poster
      class="pointer-events-none absolute inset-0 z-10 block h-full w-full object-contain opacity-100 transition-opacity duration-150 ease-out"
    />
  </div>
  <div class="h-[0.4375rem]" data-video-baseline-spacer aria-hidden="true">
  </div>
</div>
