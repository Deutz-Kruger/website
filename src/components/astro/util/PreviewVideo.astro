---
import { cn } from "@/utils/cn";
import { getMedia } from "@/utils/media";

interface Props {
  src: string;
  poster?: string;
  className?: string;
}

const { src, poster, className = "" } = Astro.props;

const { id: videoId, width, height } = getMedia(src);
const manifestUrl = `https://customer-k0tb9kusbwt5rfcb.cloudflarestream.com/${videoId}/manifest/video.m3u8`;
---

<preview-video
  src={manifestUrl}
  poster={poster}
  class={cn(className)}
  style={`--preview-aspect-ratio: ${width} / ${height}`}
  eager></preview-video>
