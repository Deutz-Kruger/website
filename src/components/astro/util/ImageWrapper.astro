---
import { Image } from "astro:assets";

import { cn } from "@/utils/cn";
import { getMedia } from "@/utils/media";

interface Props {
  src: string;
  altText: string;
  className?: string;
  imgClassName?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  showLqip?: boolean;
  sizes?: string;
  positioning?: string;
}

const {
  src,
  altText,
  className = "",
  imgClassName = "",
  loading = "lazy",
  fetchpriority = "auto",
  showLqip = true,
  sizes = "(min-width: 1024px) 40vw, (min-width: 768px) 50vw, 100vw",
} = Astro.props;

const mediaEntry = getMedia(src);

const cloudflareBaseUrl = mediaEntry
  ? `https://imagedelivery.net/MdnPOFk9l0bFpoVPozEWbw/${mediaEntry.id}/public`
  : undefined;

const loadingOrder = loading === "eager" ? loading : "lazy";

if (!(mediaEntry.width && mediaEntry.height)) {
  throw new Error(`[IMAGE ${mediaEntry.id}]: height and / or width missing`);
}

const width = mediaEntry?.width;
const height = mediaEntry?.height;
const imageClass = cn(
  "h-full w-full object-contain lg:h-full lg:max-h-full",
  imgClassName,
);
---

<div
  class={cn(
    "relative w-full overflow-hidden lg:h-full lg:max-h-full",
    className,
  )}
  data-image-frame={showLqip ? true : undefined}
>
  {
    cloudflareBaseUrl && width && height ? (
      <>
        {showLqip && (
          <img
            src={mediaEntry.lqip.src}
            alt=""
            aria-hidden="true"
            width={mediaEntry.lqip.width}
            height={mediaEntry.lqip.height}
            decoding="sync"
            draggable="false"
            data-media-lqip
            class={cn(imageClass, "pointer-events-none absolute inset-0 z-0", {
              "scale-[1.08] blur-[10px]": !mediaEntry.lqip.hasAlpha,
            })}
          />
        )}
        <Image
          src={mediaEntry.id}
          alt={altText}
          width={width}
          height={height}
          widths={[320, 640, 1024, 1920]}
          sizes={sizes}
          class={cn(imageClass, "relative z-10")}
          loading={loadingOrder}
          fetchpriority={fetchpriority}
          data-media-image
        />
      </>
    ) : (
      <div class="flex w-full items-center justify-center bg-gray-100 text-gray-500 md:h-full">
        <p>Image not found: {src}</p>
      </div>
    )
  }
</div>
