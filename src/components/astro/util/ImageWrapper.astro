---
import { cn } from "@/utils/cn";
import { getMedia } from "@/utils/media";
import { getImageSet } from "@/utils/media";

interface Props {
  src: string;
  altText: string;
  className?: string;
  loading?: string;
  sizes?: string;
}

const {
  src,
  altText,
  className = "",
  loading = "lazy",
  sizes = "(min-width: 1024px) 40vw, (min-width: 768px) 50vw, 100vw",
} = Astro.props;

const mediaEntry = getMedia(src);
const image = getImageSet(mediaEntry?.id);

const loadingOrder = loading === "eager" ? loading : "lazy";

if (!(mediaEntry.width && mediaEntry.height)) {
  throw new Error(`[IMAGE ${mediaEntry.id}]: height and / or width missing`);
}
---

<div role="presentation" class={cn(className, "h-full w-full")}>
  <img
    src={image.baseImage}
    srcset={image.srcSet}
    sizes={sizes}
    alt={altText}
    width={mediaEntry?.width}
    height={mediaEntry?.height}
    class={cn("h-full object-contain")}
    loading={loadingOrder}
  />
</div>
