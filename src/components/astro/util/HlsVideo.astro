---
import { cn } from "@/utils/cn";
import { getMedia } from "@/utils/media";

interface Props {
  src: string;
  loading?: string;
  className?: string;
  width?: number;
  height?: number;
  hasBackground?: boolean;
}

const {
  src,
  className = "",
  width,
  height,
  hasBackground = false,
} = Astro.props;

const videoId = getMedia(src).id;

const manifestUrl = `https://customer-k0tb9kusbwt5rfcb.cloudflarestream.com/${videoId}/manifest/video.m3u8`;
---

<hls-video
  src={manifestUrl}
  class={cn(className)}
  autoplay
  loop
  muted
  playsInline
  width={width}
  height={height}
  has-background={hasBackground}
>
</hls-video>
