---
import { cn } from "@/utils/cn";

interface Props {
  link: string;
  title: string;
  className?: string;
}

const { link, title, className } = Astro.props;
---

<a href={link} class="z-10">
  <div
    class={cn(
      "rounded-nav padding-nav-item shadow-nav text-medium leading-tight tracking-tight will-change-auto  w-fit h-fit bg-(--theme-color) motion-safe:hover:scale-102 motion-safe:transition motion-safe:ease-in-out motion-safe:duration-300",
      className,
    )}
  >
    {title}
  </div>
</a>
