---
import LangSelect from "./LangSelect.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";

interface Props {
  navMinHeight: number;
  logo: string;
  lang: string;
  navItems: {
    title: string;
    href: string;
  }[];
  style?: string;
}

const { navItems, navMinHeight, lang, logo, style = "" } = Astro.props;
---

<div
  class="mb-12 md:mb-4 lg:-mt-8"
  style={`height: ${navMinHeight}rem; min-height: ${navMinHeight}rem;`}
>
</div>
<header
  class="page-spacing z-100 relative left-0 top-0 mb-12 flex w-full items-center justify-between md:mb-4 lg:-mt-8"
  style={`position: fixed; width: 100%; min-height: ${navMinHeight}rem; ${style}; z-index: 100;`}
>
  <Logo lang={lang} logo={logo} />
  <Navigation navItems={navItems} lang={lang} navMinHeight={navMinHeight} />
  <LangSelect />
</header>
