---
import LangSelect from "./LangSelect.astro";
import Navigation from "./Navigation.astro";

interface Props {
  navMinHeight: number;

  lang: string;
  aspect: {
    height: number;
    width: number;
  };
  navItems: {
    title: string;
    href: string;
  }[];
  style?: string;
}

const { navItems, navMinHeight, lang, style = "", aspect } = Astro.props;
---

<div class="navbar pb-0! relative top-0 w-full"></div>
<header
  class="z-100 pointer-events-none relative left-0 top-0 w-full items-center transition-colors duration-300"
  style={`position: fixed; width: 100%; min-height: ${navMinHeight}rem; ${style}; z-index: 100;`}
>
  <div
    class="navbar max-w-480 page-spacing mx-auto flex w-full justify-between"
  >
    <div
      class="pointer-events-none box-content h-full"
      style={`aspect-ratio: ${aspect.width} / ${aspect.height};`}
    >
    </div>

    <Navigation navItems={navItems} lang={lang} />

    <LangSelect />
  </div>
</header>

<script></script>
