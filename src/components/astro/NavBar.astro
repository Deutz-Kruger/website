---
import LangSelect from "./LangSelect.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";

interface Props {
  navMinHeight: number;
  logo: string;
  lang: string;
  navItems: {
    title: string;
    href: string;
  }[];
  style?: string;
}

const { navItems, navMinHeight, lang, logo, style = "" } = Astro.props;
---

<header
  class="mb-12 flex h-10 items-center justify-between md:mb-4 md:h-16 lg:-mt-8 xl:h-20"
  style={style}
>
  <Logo lang={lang} logo={logo} />
  <Navigation navItems={navItems} lang={lang} navMinHeight={navMinHeight} />
  <LangSelect />
</header>
