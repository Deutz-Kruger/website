---
import LangSelect from "./LangSelect.astro";
import Navigation from "./Navigation.astro";

interface Props {
  navMinHeight: number;

  lang: string;
  aspect: {
    height: number;
    width: number;
  };
  navItems: {
    title: string;
    href: string;
  }[];
  style?: string;
}

const { navItems, navMinHeight, lang, style = "", aspect } = Astro.props;
---

<div
  class="page-spacing mb-12 md:mb-4 md:h-12 xl:-mt-4"
  style={`min-height: ${navMinHeight}rem;`}
>
</div>
<header
  class="z-100 pointer-events-none relative left-0 top-0 mb-12 w-full items-center xl:-mt-4"
  style={`position: fixed; width: 100%; min-height: ${navMinHeight}rem; ${style}; z-index: 100;`}
>
  <div class="max-w-480 page-spacing mx-auto flex w-full justify-between">
    <div
      class="pointer-events-none h-8 pt-2.5 md:h-12 md:pt-6 xl:pt-8"
      style={`aspect-ratio: ${aspect.width} / ${aspect.height};`}
    >
    </div>

    <Navigation navItems={navItems} lang={lang} navMinHeight={navMinHeight} />

    <LangSelect />
  </div>
</header>
