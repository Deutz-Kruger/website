---
import LangSelect from "./LangSelect.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";

interface Props {
  navMinHeight: number;
  logoWidthInRem: number;
  logo: string;
  lang: string;
  navItems: {
    title: string;
    href: string;
  }[];
}

const { navItems, navMinHeight, lang, logo, logoWidthInRem } = Astro.props;
---

<header class="flex items-center">
  <Logo lang={lang} logo={logo} logoWidthInRem={logoWidthInRem} />
  <Navigation navItems={navItems} lang={lang} navMinHeight={navMinHeight} />
  <LangSelect />
</header>
