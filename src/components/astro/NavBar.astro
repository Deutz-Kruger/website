---
import LangSelect from "./LangSelect.astro";
import Navigation from "./Navigation.astro";

interface Props {
  navMinHeight: number;

  lang: string;
  aspect: {
    height: number;
    width: number;
  };
  navItems: {
    title: string;
    href: string;
  }[];
  style?: string;
}

const { navItems, navMinHeight, lang, style = "", aspect } = Astro.props;
---

<div id="navbar" class="w-full"></div>
<header
  class="z-100 pointer-events-none relative left-0 top-0 w-full items-center xl:-mt-4"
  style={`position: fixed; width: 100%; min-height: ${navMinHeight}rem; ${style}; z-index: 100;`}
>
  <div
    id="navbar"
    class="max-w-480 page-spacing mx-auto flex w-full justify-between"
  >
    <div
      class="pointer-events-none box-content"
      style={`width: ${aspect.width}px; `}
    >
    </div>

    <Navigation navItems={navItems} lang={lang} />

    <LangSelect />
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const logoHeight = document.getElementById("fixed-logo-container");
  if (logoHeight && navbar) {
    navbar.style.height = `${logoHeight.offsetHeight}px`;
  }
</script>
