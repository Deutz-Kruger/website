---
import { type z } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { caseSchema } from "@/content/schemas/pageSchemas";
import { getVideoPoster } from "@/utils/media";

import PreviewVideo from "./util/PreviewVideo.astro";

type CasePreview = z.infer<typeof caseSchema.shape.case_preview>;
type VideoBlock = z.infer<
  typeof import("@/content/schemas/blockSchemas").videoBlock
>;

interface Props extends CasePreview {
  slug: string;
  tags: Array<string> | undefined;
  description: string;
  preview_video?: VideoBlock;
}

const { preview_image, title, slug, description, preview_video, tags } =
  Astro.props;

const lang = Astro.currentLocale ?? "en";
const videoPoster = preview_video
  ? getVideoPoster(preview_video.video)
  : undefined;
---

<a
  class="group mb-9 inline-block last:mb-0 md:last:mb-9"
  href={getRelativeLocaleUrl(lang, slug)}
>
  <hr class="mb-4 md:mb-0 md:block" />
  <div class="flex w-full flex-col md:flex-row-reverse md:justify-between">
    {
      preview_video ? (
        <PreviewVideo
          src={preview_video.video}
          poster={videoPoster}
          className="md:w-4/9 h-full mx-auto block w-full md:mx-0"
        />
      ) : (
        <div class="md:w-4/9 mx-auto block w-full md:mx-0">
          <img
            src={preview_image.src}
            alt={preview_image.alt}
            class="h-full w-full object-contain md:h-full md:max-h-full"
            loading="eager"
          />
        </div>
      )
    }

    <div class="relative mt-2 w-4/5 md:w-2/3">
      <h2
        class="text-large md:text-largerer tracking-case-mobile leading-case-mobile md:tracking-case-desktop md:leading-case-desktop md:w-6/7"
      >
        {title}
      </h2>
      <ul>
        {
          tags &&
            tags.map((tag) => {
              return <li>{tag}</li>;
            })
        }
      </ul>
      <p
        class="md:text-medium xl:text-big md:w-13/14 hidden -translate-y-1 pt-4 leading-tight tracking-tight opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100 md:block"
      >
        {description}
      </p>
    </div>
  </div>
</a>
