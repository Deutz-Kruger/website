---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import { type z } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { caseSchema } from "@/content/schemas/pageSchemas";

type CasePreview = z.infer<typeof caseSchema.shape.case_preview>;

interface Props extends CasePreview {
  slug: string;
}

const { preview_image, title, slug } = Astro.props;

const lang = Astro.currentLocale ?? "en";
---

<a class="" href={getRelativeLocaleUrl(lang, slug)}>
  <hr class="hidden md:block" />
  <div class="flex w-full flex-col md:flex-row-reverse md:justify-between">
    <ImageWrapper
      src={preview_image.src}
      altText={preview_image.alt}
      className="mx-auto block w-full md:mx-0 md:max-w-lg"
    />
    <div class="relative mt-2 w-4/5 md:w-3/5">
      <h2
        class="text-large md:text-largerer tracking-case-mobile leading-case-mobile md:tracking-case-desktop md:leading-case-desktop"
      >
        {title}
      </h2>
    </div>
    <hr class="mb-12 md:hidden" />
  </div>
</a>
