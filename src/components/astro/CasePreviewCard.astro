---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import { type z } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { caseSchema } from "@/content/schemas/pageSchemas";

type CasePreview = z.infer<typeof caseSchema.shape.case_preview>;

interface Props extends CasePreview {
  slug: string;
  description: string;
}

const { preview_image, title, slug, description } = Astro.props;

const lang = Astro.currentLocale ?? "en";
---

<a class="group mb-9 inline-block" href={getRelativeLocaleUrl(lang, slug)}>
  <hr class="mb-4 md:mb-0 md:block" />
  <div class="flex w-full flex-col md:flex-row-reverse md:justify-between">
    <ImageWrapper
      src={preview_image.src}
      altText={preview_image.alt}
      className="md:w-4/9 mx-auto block w-full md:mx-0"
    />

    <div class="relative mt-2 w-4/5 md:w-2/3">
      <h2
        class="text-large md:text-largerer tracking-case-mobile leading-case-mobile md:tracking-case-desktop md:leading-case-desktop md:w-6/7"
      >
        {title}
      </h2>
      <p
        class="md:text-medium xl:text-big md:w-13/14 hidden -translate-y-1 pt-4 leading-tight tracking-tight opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100 md:block"
      >
        {description}
      </p>
    </div>
    <!-- <hr class="mt-5 md:hidden" /> -->
  </div>
</a>
