---
import { type z } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { caseSchema } from "@/content/schemas/pageSchemas";
import { getVideoPoster } from "@/utils/media";

import Tags from "./Tags.astro";
import PreviewVideo from "./util/PreviewVideo.astro";

type CasePreview = z.infer<typeof caseSchema.shape.case_preview>;
type VideoBlock = z.infer<
  typeof import("@/content/schemas/blockSchemas").videoBlock
>;

interface Props extends CasePreview {
  slug: string;
  tags: Array<string> | undefined;
  description: string;
  preview_video?: VideoBlock;
  loading?: "eager" | "lazy";
}

const {
  preview_image,
  title,
  slug,
  description,
  preview_video,
  tags,
  loading = "lazy",
} = Astro.props;

const lang = Astro.currentLocale ?? "en";
const videoPoster = preview_video
  ? getVideoPoster(preview_video.video)
  : undefined;
---

<a
  class="group mb-9 inline-block last:mb-0 md:last:mb-9"
  href={getRelativeLocaleUrl(lang, slug)}
>
  <hr class="mb-4 md:mb-0 md:block" />
  <div class="flex w-full flex-col xl:flex-row-reverse xl:justify-between">
    {
      preview_video ? (
        <PreviewVideo
          src={preview_video.video}
          poster={videoPoster}
          className="xl:w-4/9 h-full mx-auto block w-full lg:mx-0"
        />
      ) : (
        <div class="xl:w-4/9 mx-auto block w-full lg:mx-0">
          <img
            src={preview_image.src}
            alt={preview_image.alt}
            class="h-full w-full object-contain lg:h-full lg:max-h-full"
            loading={loading}
          />
        </div>
      )
    }

    <div class="md:w-13/14 relative mt-2 xl:w-2/3">
      <h2
        class="text-large md:text-largerer tracking-case-mobile leading-case-mobile md:tracking-case-desktop md:leading-case-desktop xl:w-6/7"
      >
        {title}
      </h2>
      <p
        class="text-normal md:text-medium xl:text-big md:w-13/14 hidden -translate-y-1 pt-4 text-base leading-tight tracking-[-0.0175em] transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100 md:block xl:opacity-0"
      >
        {description}
      </p>
      <Tags tags={tags} className={"xl:absolute xl:bottom-0 xl:mt-0"} />
    </div>
  </div>
</a>
