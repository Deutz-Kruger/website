---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import { type z } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { caseSchema } from "@/content/config";

type CasePreview = z.infer<typeof caseSchema.shape.casePreview>;

interface Props extends CasePreview {
  slug: string;
}

const { previewImage, title, slug } = Astro.props;

const lang = Astro.currentLocale ?? "en";
---

<a href={getRelativeLocaleUrl(lang, slug)}>
  <hr class="hide md:block" />
  <div class="flex w-full flex-col md:flex-row-reverse md:justify-between">
    <ImageWrapper
      src={previewImage.image}
      altText={previewImage.alt}
      objectFit="contain"
      className="mx-auto block w-full md:mx-0 md:max-w-lg"
    />
    <h2
      class="text-large md:text-largest tracking-case-mobile leading-case-mobile md:tracking-case-desktop md:leading-case-desktop mt-2 w-4/5 md:w-3/5"
    >
      {title}
    </h2>
    <hr class="mb-big md:hidden" />
  </div>
</a>
