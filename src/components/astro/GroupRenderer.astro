---
import { type z } from "astro:content";

import { groupSchema } from "@/content/schemas/blockSchemas";

import BlockRenderer from "./BlockRenderer.astro";

export type Group = z.infer<typeof groupSchema>;

interface Props {
  group: Group;
  mediaStartIndex: number;
  tags: Array<string> | undefined;
}

const { group, mediaStartIndex, tags } = Astro.props;

let nextMediaIndex = mediaStartIndex;
const indexedBlocks = group.blocks.map((block) => {
  const mediaIndex = nextMediaIndex;
  if (block._block === "image" || block._block === "video") {
    nextMediaIndex += 1;
  }

  return { block, mediaIndex };
});
---

<div class="mb-5 flex h-fit flex-col gap-3 lg:mb-0 lg:contents lg:gap-0">
  {
    indexedBlocks.map(({ block, mediaIndex }) => (
      <BlockRenderer block={block} mediaIndex={mediaIndex} tags={tags} />
    ))
  }
</div>
