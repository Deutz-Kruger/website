---
import { type z } from "astro:content";

import { groupSchema } from "@/content/schemas/blockSchemas";

import BlockRenderer from "./BlockRenderer.astro";

export type Group = z.infer<typeof groupSchema>;

interface Props {
  group: Group;
}

const { group } = Astro.props;
---

<div class="mb-5 flex h-fit flex-col gap-3 md:mb-0 md:contents md:gap-0">
  {
    group.blocks.map((block, idx) => (
      <BlockRenderer block={block} index={idx} />
    ))
  }
</div>
