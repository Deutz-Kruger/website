---
import { type z } from "astro:content";

import { titleBlock } from "@/content/schemas/blockSchemas";
import {
  type CasePaths,
  extractSlugsFromPaths,
  resolveCasePreview,
} from "@/utils/collections.ts";

type TitleBlock = z.infer<typeof titleBlock>;

import CasePreviewCard from "./CasePreviewCard.astro";

interface Props {
  cases: CasePaths;
}
const { cases } = Astro.props;

const caseSlugs = extractSlugsFromPaths(cases);
const resolvedCasePreviews = await resolveCasePreview(caseSlugs);
---

<section class="md:pt-bigger relative pt-12">
  {
    resolvedCasePreviews.map((preview) => {
      const { slug, case_preview, groups } = preview.data;
      const titleBlockGroup = groups.find((group) =>
        group.blocks.find((block) => block._block === "title"),
      );
      const titleBlock: TitleBlock | undefined = titleBlockGroup?.blocks.find(
        (block) => block._block === "title",
      );

      const { title, preview_image } = case_preview;
      return (
        <CasePreviewCard
          preview_image={preview_image}
          title={title}
          slug={slug}
          description={titleBlock ? titleBlock.subHeading : ""}
        />
      );
    })
  }
  <hr class="hidden md:block" />
</section>
