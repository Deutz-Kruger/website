---
import Logo from "./Logo.astro";
interface Props {
  lang: string;
  logo: string;
  navMinHeight: number;
}

const { lang, logo, navMinHeight } = Astro.props;
console.log("navMinHeight");
---

<div
  id="fixed-logo-container"
  class="page-spacing pointer-events-none left-0 top-0 box-content h-10 pt-3.5 md:h-12 md:pt-6 xl:pt-8"
  style={`min-height: ${navMinHeight}rem;`}
>
  <Logo lang={lang} logo={logo} />
</div>

<style>
  #fixed-logo-container {
    position: fixed;
    z-index: 5; /* Behind nav content (z-100) but above the background */
    will-change: filter, transform;
  }
</style>
