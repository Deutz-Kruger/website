---
import { getRelativeLocaleUrl } from "astro:i18n";

import NavItem from "./NavItem.astro";

interface Props {
  lang: string;
  footerItems: {
    title: string;
    href: string;
  }[];
}

const { footerItems, lang } = Astro.props;
---

<footer
  class="relative mt-6 hidden w-full items-center justify-center gap-3 pb-6 pt-6 md:flex"
>
  <div
    class="absolute left-1/2 top-0 h-full w-screen -translate-x-1/2 transition-colors duration-300"
    style="background-color: var(--theme-color);"
  >
  </div>
  {
    footerItems.map((item) => {
      const { href, title } = item;
      const link = getRelativeLocaleUrl(lang, href);
      return <NavItem link={link} title={title} />;
    })
  }
</footer>
