---
import { getRelativeLocaleUrl } from "astro:i18n";

import NavItem from "./NavItem.astro";

interface Props {
  lang: string;
  footerItems: {
    title: string;
    href: string;
  }[];
}

const { footerItems, lang } = Astro.props;
---

<footer
  class="hidden w-full items-center justify-center gap-3 pb-4 pt-5 md:flex"
>
  {
    footerItems.map((item) => {
      const { href, title } = item;
      const link = getRelativeLocaleUrl(lang, href);
      return <NavItem link={link} title={title} />;
    })
  }
</footer>
