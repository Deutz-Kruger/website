---
import { type z } from "astro:content";

import { landingPageSchema } from "@/content/schemas/pageSchemas";

type Hero = z.infer<typeof landingPageSchema.shape.hero>;

interface Props {
  hero: Hero;
}

const keywords = ["development", "brands", "digital experiences"];

const generateKeywords = (match: string) => {
  let keywordColor = "--color-branding";
  switch (match) {
    case "brands":
      keywordColor = "--color-branding";
      break;
    case "development":
      keywordColor = "--color-development";
      break;
    case "digital experiences":
      keywordColor = "--color-design";
      break;
  }
  return `<span class="keyword" data-color="${keywordColor}" style="cursor: pointer;">${match}</span>`;
};

const { hero } = Astro.props;

const highlightedHeadline = hero.headline.replace(
  new RegExp(`(${keywords.join("|")})`, "gi"),
  generateKeywords,
);

const contactLine = hero.contact
  .replace(
    "hi@deutzkrueger.de",
    "<a href='mailto:hi@deutzkrueger.de' class='keyword not-italic!'>hi@deutzkrueger.de</a>",
  )
  .replace(/\n/g, "<br />");
---

<section
  class="md:pt-big xl:pt-biggest 2xl:pt-huge relative mb-4 flex flex-col justify-end pb-8 md:mb-8"
>
  <div
    class="absolute left-1/2 -z-10 w-screen -translate-x-1/2 transition-colors duration-300"
    style="background-color: var(--theme-color); top: -50vh; height: calc(100% + 50vh);"
  >
  </div>
  <h1
    class="text-large md:text-largerer tracking-heading-mobile-mobile leading-heading-mobile md:leading-heading-mobile-desktop md:tracking-heading-mobile-desktop w-6/7 xl:w-12/17 mb-4 md:mb-12"
    set:html={highlightedHeadline}
  />
  <h2
    class="text-large md:text-largerer tracking-heading-mobile-mobile leading-heading-mobile md:leading-heading-mobile-desktop md:tracking-heading-mobile-desktop md:w-15/17 2xl:w-8/17 3xl:w- ml-auto w-5/6 text-right"
    set:html={contactLine}
  />
</section>
