---
import { type z } from "astro:content";

import { landingPageSchema } from "@/content/schemas/pageSchemas";

type Hero = z.infer<typeof landingPageSchema.shape.hero>;

interface Props {
  hero: Hero;
}

const keywords = ["development", "brands", "digital experiences"];

const generateKeywords = (match: string) => {
  let keywordColor = "--color-blue";
  switch (match) {
    case "brands":
      keywordColor = "--color-blue";
      break;
    case "development":
      keywordColor = "--color-green";
      break;
    case "digital experiences":
      keywordColor = "--color-red";
      break;
  }
  return `<span class="keyword" data-color="${keywordColor}" style="cursor: pointer;">${match}</span>`;
};

const { hero } = Astro.props;

const highlightedHeadline = hero.headline.replace(
  new RegExp(`(${keywords.join("|")})`, "gi"),
  generateKeywords,
);
---

<section class="mt-biggest md:mt-huge mb-12 flex flex-col justify-end">
  <div id="store-test"></div>
  <h1
    class="text-large md:text-largest tracking-hero-mobile leading-hero-mobile md:leading-hero-desktop md:tracking-hero-desktop w-6/7 md:w-14/17"
    set:html={highlightedHeadline}
  />
</section>

<script>
  import { setKeyword } from "@/stores/keywordStore";

  document.addEventListener("astro:page-load", () => {
    const keywordElements = document.querySelectorAll(".keyword");
    keywordElements.forEach((el) => {
      console.log("Clicked Color");
      const element = el as HTMLElement;
      if (element.dataset.color) {
        el.addEventListener("click", () => {
          if (!element.dataset.color) return;
          setKeyword(element.dataset.color);
        });
      }
    });
  });
</script>
