---
import { type z } from "astro:content";

import { servicesSchema } from "@/content/schemas/pageSchemas";
import { cn } from "@/utils/cn";

type ServiceProps = z.infer<typeof servicesSchema.element>;

interface Props extends ServiceProps {
  idx: number;
}

const { title, body, idx } = Astro.props;

let bgColorIcon = "#FFFFFF";

switch (title) {
  case "Branding":
    bgColorIcon = "--color-branding";
    break;
  case "Design":
    bgColorIcon = "--color-design";
    break;
  case "Development":
    bgColorIcon = "--color-development";
}

const even = idx % 2 !== 0;
---

<div
  class={cn(
    "service-card relative  min-h-70  lg:border-h lg:not-first:pl-6 lg:w-1/3 lg:pt-3 ",
    {
      "lg:border-x": even,
    },
  )}
  data-color={bgColorIcon}
>
  <hr class="mb-2 lg:mb-0 lg:hidden" />
  <div class="flex items-center">
    <div class="service-placeholder-bg mr-3 grid h-6 w-8 lg:h-7 lg:w-9"></div>
    <div
      class="service-animated-bg -z-1 absolute"
      style={`background: var(${bgColorIcon})`}
    >
    </div>
    <h2 class="text-large md:text-larger z-10">{title}</h2>
  </div>
  <p
    class="text-normal md:text-medium xl:text-big z-10 mt-2 text-base leading-tight tracking-[-0.0175em] lg:pr-6 2xl:pr-9"
  >
    {body}
  </p>
</div>
