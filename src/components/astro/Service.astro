---
import { type z } from "astro:content";

import { servicesSchema } from "@/content/schemas/pageSchemas";

type Props = z.infer<typeof servicesSchema.element>;

const { title, body } = Astro.props;

let bgColorIcon = "#FFFFFF";

switch (title) {
  case "Branding":
    bgColorIcon = "--color-branding";
    break;
  case "Design":
    bgColorIcon = "--color-design";
    break;
  case "Development":
    bgColorIcon = "--color-development";
}
---

<div
  class="min-h-70 lg:border-h lg:not-first:pl-6 lg:w-1/3 lg:pt-3 lg:even:border-x"
>
  <hr class="mb-2 lg:mb-0 lg:hidden" />
  <div class="flex items-center">
    <div
      class="mr-3 grid h-6 w-8 lg:h-7 lg:w-9"
      style={`background: var(${bgColorIcon})`}
    >
    </div>
    <h2 class="text-large md:text-larger">{title}</h2>
  </div>
  <p
    class="text-normal md:text-medium xl:text-big mt-2 text-base leading-tight tracking-[-0.0175em] lg:pr-6 2xl:pr-9"
  >
    {body}
  </p>
</div>
