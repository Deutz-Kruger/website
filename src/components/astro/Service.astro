---
import ImageWrapper from "@components/astro/util/ImageWrapper.astro";
import { type z } from "astro:content";

import { servicesSchema } from "@/content/schemas/pageSchemas";

type Props = z.infer<typeof servicesSchema.element>;

const { title, body, icon } = Astro.props;

let bgColorIcon = "#FFFFFF";

switch (title) {
  case "Branding":
    bgColorIcon = "--color-blue";
    break;
  case "Design":
    bgColorIcon = "--color-red";
    break;
  case "Development":
    bgColorIcon = "--color-green";
}
---

<div class="p-page-mobile min-h-70 md:border-h md:w-1/3 md:even:border-x">
  <hr class="mb-2 md:mb-0 md:hidden" />
  <div class="flex items-center">
    <div
      class="rounded-icon mr-1.5 grid h-6 items-center p-0.5 px-1.5 py-1 md:h-9"
      style={`background: var(${bgColorIcon})`}
    >
      <ImageWrapper
        src={icon.icon_logo.src}
        className="h-full self-center"
        altText="Services Logo"
      />
    </div>
    <h2 class="text-large md:text-larger">{title}</h2>
  </div>
  <p class="w-40/41 md:text-big text-base leading-tight tracking-[-0.0175em]">
    {body}
  </p>
</div>
