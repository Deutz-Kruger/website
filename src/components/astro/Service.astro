---
import { type z } from "astro:content";

import { servicesSchema } from "@/content/schemas/pageSchemas";

type Props = z.infer<typeof servicesSchema.element>;

const { title, body } = Astro.props;

let bgColorIcon = "#FFFFFF";

switch (title) {
  case "Branding":
    bgColorIcon = "--color-branding";
    break;
  case "Design":
    bgColorIcon = "--color-design";
    break;
  case "Development":
    bgColorIcon = "--color-development";
}
---

<div
  class="min-h-70 md:border-h md:not-first:pl-6 md:w-1/3 md:pt-3 md:even:border-x"
>
  <hr class="mb-2 md:mb-0 md:hidden" />
  <div class="flex items-center">
    <div
      class="mr-3 grid h-6 w-8 md:h-7 md:w-9"
      style={`background: var(${bgColorIcon})`}
    >
    </div>
    <h2 class="text-large md:text-larger">{title}</h2>
  </div>
  <p class="w-40/41 md:text-big text-base leading-tight tracking-[-0.0175em]">
    {body}
  </p>
</div>
