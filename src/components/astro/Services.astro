---
import Service from "@components/astro/Service.astro";
import { servicesSchema } from "@content/config";
import { z } from "astro:content";

export type Services = z.infer<typeof servicesSchema>;

interface Props {
  services: Services;
}

const { services } = Astro.props;
---

<section
  class="-m-page-mobile md:-m-page-desktop md:px-page-desktop h-full bg-white md:pt-24"
>
  <hr class="hidden md:block" />
  <div class="md:flex md:min-h-[600px]">
    {
      services.map((service) => {
        const { title, body, icon } = service;

        return <Service title={title} body={body} icon={icon} />;
      })
    }
  </div>
</section>
