---
import Service from "@components/astro/Service.astro";
import { servicesSchema } from "@content/schemas/pageSchemas";
import { z } from "astro:content";

export type Services = z.infer<typeof servicesSchema>;

interface Props {
  services: Services;
}

const { services } = Astro.props;
---

<section class="h-full">
  <hr class="hidden lg:block" />
  <div class="lg:flex lg:min-h-[600px]">
    {
      services.map((service, idx) => {
        const { title, body, icon } = service;

        return <Service idx={idx} title={title} body={body} icon={icon} />;
      })
    }
  </div>
</section>

<style is:global>
  .service-card.is-active .service-animated-bg {
    /* ...override the JS styles and fill the screen */
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;

    transition: all 0.4s ease-in-out;
  }
  .service-card.is-active .service-placeholder-bg {
    width: 0px;
    margin: 0px;
    transition: all 0.25s ease-out;
  }
</style>
