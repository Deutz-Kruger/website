---
import Service from "@components/astro/Service.astro";
import { servicesSchema } from "@content/schemas/pageSchemas";
import { z } from "astro:content";

export type Services = z.infer<typeof servicesSchema>;

interface Props {
  services: Services;
}

const { services } = Astro.props;
---

<section class="h-full">
  <hr class="hidden lg:block" />
  <div class="lg:flex lg:min-h-[600px]">
    {
      services.map((service) => {
        const { title, body, icon } = service;

        return <Service title={title} body={body} icon={icon} />;
      })
    }
  </div>
</section>
