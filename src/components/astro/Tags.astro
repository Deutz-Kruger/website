---
interface Props {
  tags: Array<string> | undefined;
}
const { tags } = Astro.props;
---

{
  tags && (
    <ul class="mt-3 flex gap-2 xl:absolute xl:bottom-0 xl:mt-0">
      {tags.map((tag) => {
        return (
          <li class="bg-(--theme-color)/75 rounded-nav padding-nav-item transition-colors duration-500">
            {tag}
          </li>
        );
      })}
    </ul>
  )
}
