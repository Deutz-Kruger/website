---
import { cn } from "@/utils/cn";

interface Props {
  tags: Array<string> | undefined;
  className?: string;
}
const { tags, className = "" } = Astro.props;
---

{
  tags && (
    <ul class={cn("mt-3 flex flex-wrap gap-3", className)}>
      {tags.map((tag) => {
        return (
          <li class="bg-(--theme-color) rounded-nav px-2 py-0.5 transition-colors duration-500">
            {tag}
          </li>
        );
      })}
    </ul>
  )
}
