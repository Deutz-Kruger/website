---
import { getRelativeLocaleUrl } from "astro:i18n";

import ImageWrapper from "./util/ImageWrapper.astro";

interface Props {
  lang: string;
  logo: string;
}

const { lang, logo } = Astro.props;
---

<a href={getRelativeLocaleUrl(lang, "/")}>
  <ImageWrapper
    src={logo}
    altText="Deutz & Krüger Logo"
    loading="eager"
    className="h-full w-full"
  />
</a>
