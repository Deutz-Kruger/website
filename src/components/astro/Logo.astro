---
import { getRelativeLocaleUrl } from "astro:i18n";

import ImageWrapper from "./util/ImageWrapper.astro";

interface Props {
  lang: string;
  logo: string;
}

const { lang, logo } = Astro.props;
---

<a
  href={getRelativeLocaleUrl(lang, "/")}
  class="inline-block h-8 md:h-11 lg:h-16"
>
  <ImageWrapper
    src={logo}
    altText="Deutz & Krüger Logo"
    loading="eager"
    className="z-100 h-full w-full"
  />
</a>
