---
import "../styles/global.css";

import SeoLayout from "./SeoLayout.astro";
import SiteLayout from "./SiteLayout.astro";

const { title, description = "Deutz & Krüger" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scrollbar-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoLayout title={title} description={description} />
  </head>
  <body>
    <SiteLayout>
      <slot />
    </SiteLayout>
    <script src="@/scripts/backgroundColorSwitch.ts"></script>
    <script src="@/scripts/swup.ts"></script>
  </body>
</html>

<style is:global>
  /* Define a transition duration during page visits */
  html.is-changing .transition-fade {
    transition: opacity 0.25s;
    opacity: 1;
  }

  /* Define the styles for the unloaded pages */
  html.is-animating .transition-fade {
    opacity: 0;
  }
</style>
