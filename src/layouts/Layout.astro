---
import "../styles/global.css";

import SeoLayout from "./SeoLayout.astro";
import SiteLayout from "./SiteLayout.astro";

const { title, description = "Deutz & Krüger" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scrollbar-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoLayout title={title} description={description} />
  </head>
  <body>
    <SiteLayout>
      <slot />
    </SiteLayout>
    <script src="@/scripts/backgroundColorSwitch.ts"></script>
    <script src="@/scripts/swup.ts"></script>
  </body>
</html>

<style is:global>
  .transition-main {
    transition-property: opacity, transform;
    transition-duration: 350ms;
    transition-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
    transform: translateX(0);
    opacity: 1;
  }

  html.is-animating .transition-main {
    opacity: 0;
    transform: translateX(-1em);
  }

  html.is-leaving .transition-main {
    transform: translateX(1em);
  }

  html.is-animating.to-left .transition-main {
    opacity: 0;
    transform: translateX(1em);
  }

  html.is-leaving.to-left .transition-main {
    transform: translateX(-1em);
  }
</style>
