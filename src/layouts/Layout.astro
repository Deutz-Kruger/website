---
import "../styles/global.css";
import "lenis/dist/lenis.css";

import type { LocaleAlternates } from "@/utils/locale";
import type { SeoImage, StructuredData } from "@/utils/seo";

import SeoLayout from "./SeoLayout.astro";
import SiteLayout from "./SiteLayout.astro";

interface Props {
  title?: string;
  description?: string;
  socialImage?: SeoImage;
  noIndex?: boolean;
  canonical?: string | false;
  localeAlternates?: LocaleAlternates | false;
  structuredData?: StructuredData | false;
  streamPreconnect?: boolean;
}

const {
  title,
  description,
  socialImage,
  noIndex,
  canonical,
  localeAlternates,
  structuredData,
  streamPreconnect = false,
} = Astro.props;
const documentLocale = Astro.currentLocale === "de" ? "de" : "en";
---

<!doctype html>
<html lang={documentLocale} class="scrollbar-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="preload"
      href="/fonts/OpeningHoursSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
    {
      streamPreconnect && (
        <link
          rel="preconnect"
          href="https://customer-k0tb9kusbwt5rfcb.cloudflarestream.com"
          crossorigin
        />
      )
    }
    <link rel="manifest" href="/site.webmanifest" />
    <SeoLayout
      title={title}
      description={description}
      socialImage={socialImage}
      noIndex={noIndex}
      canonical={canonical}
      localeAlternates={localeAlternates}
      structuredData={structuredData}
    />

    <script src="@/scripts/app.ts"></script>
  </head>
  <body>
    <SiteLayout>
      <slot />
    </SiteLayout>
  </body>
</html>

<style is:global>
  .transition-main {
    transition-property: opacity, transform;
    transition-duration: 350ms;
    transition-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
    transform: translateX(0);
    opacity: 1;
  }

  html.is-animating .transition-main {
    opacity: 0;
    transform: translateX(-1em);
  }

  html.is-leaving .transition-main {
    transform: translateX(1em);
  }

  html.is-animating.to-left .transition-main {
    opacity: 0;
    transform: translateX(1em);
  }

  html.is-leaving.to-left .transition-main {
    transform: translateX(-1em);
  }

  @media (prefers-reduced-motion: reduce) {
    .transition-main,
    html.is-animating .transition-main,
    html.is-leaving .transition-main,
    html.is-animating.to-left .transition-main,
    html.is-leaving.to-left .transition-main {
      opacity: 1;
      transform: translateX(0);
      transition: none;
    }
  }
</style>
