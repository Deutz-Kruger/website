---
import "../styles/global.css";

import SeoLayout from "./SeoLayout.astro";
import SiteLayout from "./SiteLayout.astro";

const { title, description = "Deutz & Krüger" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scrollbar-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoLayout title={title} description={description} />
  </head>
  <body class="overflow-x-hidden p-2.5 tracking-[1%] antialiased md:p-6">
    <SiteLayout>
      <slot />
    </SiteLayout>
  </body>
</html>

<script>
  import { keywordColor } from "@/stores/keywordStore";
  keywordColor.subscribe((color) => {
    const body = document.querySelector("body");
    if (!body) return;
    body.style.backgroundColor = `var(${color})`;
  });
</script>
