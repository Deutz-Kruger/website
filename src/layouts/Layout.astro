---
import "../styles/global.css";

// import "@/scripts/backgroundColorSwitch.ts";
import { ClientRouter } from "astro:transitions";

import SeoLayout from "./SeoLayout.astro";
import SiteLayout from "./SiteLayout.astro";

const { title, description = "Deutz & Krüger" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scrollbar-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoLayout title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    <SiteLayout transition:persist>
      <slot />
    </SiteLayout>
    <script src="@/scripts/backgroundColorSwitch.ts"></script>
  </body>
</html>
