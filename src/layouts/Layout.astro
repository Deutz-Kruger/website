---
import "../styles/global.css";

import SeoLayout from "./SeoLayout.astro";
import SiteLayout from "./SiteLayout.astro";

const { title, description = "Deutz & Krüger" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scrollbar-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoLayout title={title} description={description} />
  </head>
  <body>
    <SiteLayout>
      <slot />
    </SiteLayout>
    <script src="@/scripts/backgroundColorSwitch.ts"></script>
  </body>
</html>
