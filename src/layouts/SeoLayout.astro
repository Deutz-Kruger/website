---
import { getEntry } from "astro:content";

import { serializeJsonLd } from "@/utils/contentSecurity";
import { getLocaleAlternates, type LocaleAlternates } from "@/utils/locale";
import {
  buildCanonicalUrl,
  getRobotsContent,
  type SeoImage,
  type StructuredData,
} from "@/utils/seo";

interface Props {
  title?: string;
  description?: string;
  socialImage?: SeoImage;
  noIndex?: boolean;
  canonical?: string | false;
  localeAlternates?: LocaleAlternates | false;
  structuredData?: StructuredData | false;
}

const settings = await getEntry("settings", "settings");
const siteUrl = import.meta.env.SITE_URL || "https://deutzkrueger.de";
const normalizedSiteUrl = siteUrl.replace(/\/$/, "");
const appEnv = import.meta.env.APP_ENV || "development";
const DEFAULT_TITLE = settings?.data.title || "Deutz & Krüger";
const DEFAULT_DESCRIPTION =
  settings?.data.description ||
  "Manuel Krüger & Marvin Deutz: A Berlin-based duo connecting clarity in design with creativity in technology to build brands and digital experiences.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  socialImage,
  noIndex = false,
  canonical,
  localeAlternates: localeAlternatesProp,
  structuredData: structuredDataProp,
} = Astro.props;

const currentLocale = Astro.currentLocale || "en";
const ogLocale = currentLocale === "de" ? "de_DE" : "en_US";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isIndexPage = currentPath === "/en" || currentPath === "/de";
const pageTitle = isIndexPage ? DEFAULT_TITLE : title || DEFAULT_TITLE;
const fullTitle = isIndexPage ? pageTitle : `${pageTitle} | ${DEFAULT_TITLE}`;
const canonicalUrl =
  canonical === false
    ? undefined
    : canonical || buildCanonicalUrl(siteUrl, Astro.url.pathname);
const localeAlternates =
  localeAlternatesProp === false
    ? undefined
    : localeAlternatesProp || getLocaleAlternates(siteUrl, Astro.url.pathname);
const robotsContent = getRobotsContent(appEnv, noIndex);
const defaultSocialImage: SeoImage = {
  url: `${normalizedSiteUrl}/og.png`,
  alt: DEFAULT_TITLE,
  width: 1600,
  height: 800,
  type: "image/png",
};
const resolvedSocialImage = socialImage || defaultSocialImage;

const websiteStructuredData: StructuredData | undefined = isIndexPage
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${normalizedSiteUrl}/#organization`,
          name: DEFAULT_TITLE,
          url: normalizedSiteUrl,
          logo: {
            "@type": "ImageObject",
            url: `${normalizedSiteUrl}/android-chrome-512x512.png`,
            width: 512,
            height: 512,
          },
          address: {
            "@type": "PostalAddress",
            addressLocality: "Berlin",
            addressCountry: "DE",
          },
          sameAs: [
            "https://www.linkedin.com/company/deutzkrueger",
            "https://github.com/deutz-kruger",
          ],
        },
        {
          "@type": "WebSite",
          "@id": `${normalizedSiteUrl}/#website`,
          url: normalizedSiteUrl,
          name: DEFAULT_TITLE,
          description,
          publisher: {
            "@id": `${normalizedSiteUrl}/#organization`,
          },
          inLanguage: ["en", "de"],
        },
      ],
    }
  : undefined;

const structuredData =
  structuredDataProp === false
    ? undefined
    : structuredDataProp || websiteStructuredData;
const jsonLd = structuredData ? serializeJsonLd(structuredData) : undefined;
---

<title>{fullTitle}</title>
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

{
  canonicalUrl && (
    <>
      <meta property="og:title" content={fullTitle} />
      <meta property="og:type" content="website" />
      <meta property="og:image" content={resolvedSocialImage.url} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:description" content={description} />
      <meta property="og:locale" content={ogLocale} />
      <meta property="og:site_name" content={DEFAULT_TITLE} />
      <meta property="og:image:url" content={resolvedSocialImage.url} />
      {resolvedSocialImage.type && (
        <meta property="og:image:type" content={resolvedSocialImage.type} />
      )}
      <meta
        property="og:image:width"
        content={String(resolvedSocialImage.width)}
      />
      <meta
        property="og:image:height"
        content={String(resolvedSocialImage.height)}
      />
      <meta property="og:image:alt" content={resolvedSocialImage.alt} />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={fullTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={resolvedSocialImage.url} />
      <meta name="twitter:image:alt" content={resolvedSocialImage.alt} />
    </>
  )
}

<meta name="author" content={DEFAULT_TITLE} />
<meta name="theme-color" content="#000000" />
<meta name="msapplication-TileColor" content="#000000" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{
  localeAlternates && (
    <>
      <link rel="alternate" hreflang="en" href={localeAlternates.en} />
      <link rel="alternate" hreflang="de" href={localeAlternates.de} />
      <link
        rel="alternate"
        hreflang="x-default"
        href={localeAlternates.xDefault}
      />
    </>
  )
}

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
