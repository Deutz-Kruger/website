---
import { SEO } from "astro-seo";

const siteUrl = import.meta.env.SITE_URL || "https://deutzkrueger.de";
const appEnv = import.meta.env.APP_ENV || "development";

const allowIndexing = appEnv === "production";
const robotsContent = allowIndexing ? "index, follow" : "noindex, nofollow";
const DEFAULT_DESCRIPTION =
  "Manuel Krüger & Marvin Deutz: A Berlin-based duo connecting clarity in design with creativity in technology to build brands and digital experiences.";
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

const currentLocale = Astro.currentLocale || "en";
const ogLocale = currentLocale === "de" ? "de_DE" : "en_US";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isIndexPage =
  currentPath === "/" || currentPath === "/en" || currentPath === "/de";

const DEFAULT_TITLE = "Deutz & Krüger";

const pageTitle = isIndexPage ? DEFAULT_TITLE : title || DEFAULT_TITLE;
const titleTemplate = isIndexPage ? "%s" : "%s | Deutz & Krüger";
---

<SEO
  title={pageTitle}
  titleDefault={DEFAULT_TITLE}
  titleTemplate={titleTemplate}
  description={description}
  canonical={Astro.url.toString()}
  noindex={!allowIndexing}
  nofollow={!allowIndexing}
  openGraph={{
    basic: {
      title: title || DEFAULT_TITLE,
      type: "website",
      image: `${siteUrl}/og.png`,
      url: Astro.url.toString(),
    },
    image: {
      alt: DEFAULT_TITLE,
      width: 1600,
      height: 800,
      type: "image/png",
    },
    optional: {
      description,
      siteName: DEFAULT_TITLE,
      locale: ogLocale,
    },
  }}
  twitter={{
    card: "summary_large_image",
    site: "",
    creator: "",
    title: title || DEFAULT_TITLE,
    description,
    image: `${siteUrl}/og.png`,
    imageAlt: DEFAULT_TITLE,
  }}
  extend={{
    meta: [
      { name: "author", content: "Deutz & Krüger" },
      {
        name: "keywords",
        content:
          "Web Agency Berlin, Webagentur Berlin, Web Design, UI/UX, Web Development, Astro, React, Digitalagentur, Deutz & Krüger, Wordpress, E-Commerce, Webentwicklung",
      },
      { name: "googlebot", content: robotsContent },
      { name: "theme-color", content: "#000000" },
      { name: "msapplication-TileColor", content: "#000000" },
    ],
    link: [
      {
        rel: "apple-touch-icon",
        sizes: "180x180",
        href: "/apple-touch-icon.png",
      },
      {
        rel: "icon",
        type: "image/png",
        sizes: "32x32",
        href: "/favicon-32x32.png",
      },
      {
        rel: "icon",
        type: "image/png",
        sizes: "16x16",
        href: "/favicon-16x16.png",
      },
      {
        rel: "icon",
        type: "image/x-icon",
        href: "/favicon.ico",
      },
    ],
  }}
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        name: "Deutz & Krüger",
        url: siteUrl,
        logo: {
          "@type": "ImageObject",
          url: `${siteUrl}/web-app-manifest-512x512.png`,
          width: 512,
          height: 512,
        },
        address: {
          "@type": "PostalAddress",
          addressLocality: "Berlin",
          addressCountry: "DE",
        },
        sameAs: [
          "https://www.linkedin.com/company/deutzkrueger",
          "https://github.com/deutz-kruger",
        ],
      },
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        url: siteUrl,
        name: "Deutz & Krüger",
        description: description,
        publisher: {
          "@id": `${siteUrl}/#organization`,
        },
        inLanguage: currentLocale,
      },
    ],
  })}
/>
