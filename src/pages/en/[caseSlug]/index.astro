---
import type { GetStaticPaths } from "astro";
import { getCollection, type z } from "astro:content";

import GroupRenderer from "@/components/astro/GroupRenderer.astro";
import { caseSchema } from "@/content/schemas/pageSchemas";
import Layout from "@/layouts/Layout.astro";
import { getCloudflareImageUrl, getMedia } from "@/utils/media";
import { indexMediaGroups } from "@/utils/mediaOrder";
import { getCaseSeoData } from "@/utils/seo";

export const getStaticPaths = (async () => {
  const cases = await getCollection("cases", (entry) =>
    entry.id.endsWith(".en"),
  );
  const paths = cases.map((caseEntry) => {
    const { slug } = caseEntry.data;
    return {
      params: {
        caseSlug: slug.replace("/", ""),
      },
      props: {
        caseEntry: caseEntry.data,
      },
    };
  });
  return paths;
}) satisfies GetStaticPaths;

export type CaseEntry = z.infer<typeof caseSchema>;

interface Props {
  caseEntry: CaseEntry;
}

const { caseEntry } = Astro.props;
const { case_preview, groups, tags } = caseEntry;
const previewMedia = getMedia(case_preview.preview_image.src);
const seo = getCaseSeoData(
  caseEntry,
  import.meta.env.SITE_URL || "https://deutzkrueger.de",
  Astro.url.pathname,
  {
    url: getCloudflareImageUrl(case_preview.preview_image.src),
    alt: case_preview.preview_image.alt,
    width: previewMedia.width,
    height: previewMedia.height,
  },
);

const indexedGroups = indexMediaGroups(groups);
---

<Layout
  title={seo.title}
  description={seo.description}
  socialImage={seo.socialImage}
  canonical={seo.canonical}
  structuredData={seo.structuredData}
  streamPreconnect
>
  <hr class="mb-4 lg:mb-6" />
  <main class="relative grid grid-cols-1 lg:grid-cols-4 lg:gap-6">
    {
      indexedGroups.map(({ group, mediaStartIndex, imageStartIndex }) => (
        <GroupRenderer
          group={group}
          mediaStartIndex={mediaStartIndex}
          imageStartIndex={imageStartIndex}
          tags={tags}
        />
      ))
    }
  </main>
</Layout>
