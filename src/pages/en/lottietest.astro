  -->
  <hr />
  <h2 class="mt-8 text-3xl">Shader</h2>
  <div>
    <div id="lottie-1" class="relative">
      <div
        class="absolute top-0 flex h-full w-full items-center justify-between py-4"
      >
        {
          images.map((image, index) => {
            return (
              <Image
                class="h-full object-contain"
                src={image}
                alt={`Lottie - ${index}`}
                loading={"eager"}
              />
            );
          })
        }
      </div>
    </div>
  </div>
