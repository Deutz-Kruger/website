---
import img1 from "src/placeholder/iPhone 16 - 1.png";
import img2 from "src/placeholder/iPhone 16 - 2.png";
import img3 from "src/placeholder/iPhone 16 - 3.png";
import img4 from "src/placeholder/iPhone 16 - 4.png";

const images = [img1, img2, img3, img4];

import { Image } from "astro:assets";

import { BackgroundGradient } from "@/components/react/BackgroundGradient";
import Layout from "@/layouts/Layout.astro";
import { cn } from "@/utils/cn";
---

<Layout>
  <h1 class="text-4xl">Gradient Test</h1>
  <hr />
  <h2 class="mt-8 text-3xl">Pure Shader + R3F - Blue Colors</h2>
  <div class="h-[450px]">
    <BackgroundGradient
      gradientCols={["#000F79", "#053CA1", "#2586F7", "#FFFFFF"]}
      className={cn("py-4")}
      client:visible
    >
      {
        images.map((image, index) => {
          return (
            <Image
              class="h-full object-contain"
              src={image}
              alt={`Lottie - ${index}`}
              loading={"eager"}
            />
          );
        })
      }
    </BackgroundGradient>
  </div>
  <h2 class="mt-8 text-3xl">Pure Shader + R3F - Blue Colors</h2>
  <div class="h-[450px]">
    <BackgroundGradient
      gradientCols={["#D92C2E", "#FFC6A9", "#F8E0C8", "#FEF1E0"]}
      className={cn("py-4")}
      client:visible
    >
      {
        images.map((image, index) => {
          return (
            <Image
              class="h-full object-contain"
              src={image}
              alt={`Lottie - ${index}`}
              loading={"eager"}
            />
          );
        })
      }
    </BackgroundGradient>
  </div>
</Layout>
