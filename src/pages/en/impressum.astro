    <h1
      class="text-large md:text-largerer tracking-case-mobile leading-case-mobile md:tracking-case-desktop md:leading-case-desktop mb-4 text-center"
    >
      {impressum.title}
    </h1>
    <h2 class="text-medium mb-1">Diese Website wird betrieben von:</h2>
    <div class="gap-12 lg:flex">
      <div class="mb-4">
        <h3 class="text-medium mb-1">Design & Branding</h3>
        <div class="mb-1 flex flex-col gap-0">
          <span>Manuel Krüger </span>
          <span>Gürtelstraße 13</span>
          <span>13088, Berlin</span>
        </div>
        <div class="flex flex-col">
          <a href="mailto:manuel@deutzkrueger.de">manuel@deutzkrueger.de</a>
          <a href="tel:00491716474211">+491716474211</a>
        </div>
      </div>
      <div>
        <h3 class="text-medium mb-1">Development & Technical Solutions</h3>
        <div class="mb-1 flex flex-col gap-0">
          <span>Marvin Deutz</span>
          <span>Tempelhofer Damm 206</span>
          <span>12099, Berlin</span>
        </div>
        <div class="mb-1 flex flex-col gap-0">
          <a href="mailto:manuel@deutzkrueger.de">marvin@deutzkrueger.de</a>
          <a href="tel:00491775013739">+491716474211</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
