---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main class="mx-auto flex h-[80vh] w-fit flex-col justify-center gap-4">
    <h1 class="text-largest text-center">404</h1>
    <p
      class="text-large mx-auto w-1/2 text-center leading-tight tracking-tighter"
    >
      Oops, the page couldn't be found. It is possible that it hasn't been
      translated yet.
    </p>
    <a class="text-medium mx-auto italic underline" href="/en">
      <div class="rounded-nav border-2 px-3 py-2">Back to safety.</div>
    </a>
  </main>
</Layout>
